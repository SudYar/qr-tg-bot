# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Proverkacheka API Token (https://proverkacheka.com)
CHEK_TOKEN=your_proverkacheka_token_here

# Proverkacheka API URL (обычно не требует изменений)
CHEK_URL=https://proverkacheka.com/api/v1/check/get

# Таймаут для API запросов в секундах (по умолчанию: 10)
API_TIMEOUT=10

# Режим отладки (включает debug команды и детальное логирование)
# Допустимые значения: True, False, 1, 0, yes, no (по умолчанию: False)
DEBUG=False

# Уровень логирования (по умолчанию: INFO в production, DEBUG если DEBUG=True)
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
